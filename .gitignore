# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
/.pnp
.pnp.js

# Compiled Sanity Studio
studio/dist

# Temporary Sanity runtime, generated by the CLI on every dev server start
studio/.sanity

# Logs
/logs
*.log

# Coverage directory used by testing tools
/coverage

# Misc
.DS_Store
*.pem

# Typescript
*.tsbuildinfo

# Dotenv and similar local-only files
*.local

# Astro
site/dist
site/dist-fixtures
site/.astro

# Sanity schema extract (generated)
studio/schema.json

# Wrangler
.wrangler

# Dataset exports taken before a migration — the undo. Kept on disk on
# purpose; never committed (they are large and contain a full content dump).
/backup-*.ndjson.gz
/backup-*.tar.gz

# Local-only Workers runtime vars (astro dev under the cloudflare adapter
# reads these into the workerd sandbox; process.env from the host doesn't
# reach it the way it does for the static build).
.dev.vars

# eslint -> SARIF artifacts. Written by the eslint-sarif job in verify.yml, and
# by hand when reproducing it locally.
eslint-*.json
*.sarif
