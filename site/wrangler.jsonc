{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "softmess",
  "compatibility_date": "2026-08-15",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    {"pattern": "softmess.de", "custom_domain": true},
    {"pattern": "www.softmess.de", "custom_domain": true}
  ]
}
