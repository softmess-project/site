---
import type {NavLink, SiteSettings} from '../lib/content'
import {externalAttrs} from '../lib/link'
interface Props {
  settings: SiteSettings
  links?: NavLink[] | null
}
const {settings, links} = Astro.props
const linkClass = 'text-[15px] text-ink hover:text-accent'
---

<header class="relative flex items-center justify-between gap-4 px-[clamp(24px,6vw,88px)] py-6">
  <a href="/" class="font-display text-[22px] tracking-[0.01em] text-accent no-underline"
    >{settings.brand}</a
  >
  <div class="flex items-center gap-4">
    {
      links && links.length > 0 && (
        <nav class="flex flex-wrap gap-x-4 gap-y-1">
          {links.map((link) => (
            <a class={linkClass} href={link.href} {...externalAttrs(link.href)}>
              {link.label}
            </a>
          ))}
        </nav>
      )
    }
    <span class="text-[13px] uppercase tracking-[0.14em] text-muted">{settings.tagline}</span>
  </div>
</header>
